[Unit]
Description=Password Safe local vault HTTP API (bind localhost only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 系统级安装时取消下一行注释并改成你的用户名：
# User=YOUR_USERNAME
# Group=YOUR_USERNAME

Environment=PASSWORD_SAFE_VAULT=%h/.password-safe/vault.dat
Environment=PASSWORD_SAFE_ADDR=127.0.0.1:8787

# 二进制安装路径（按实际修改）
ExecStart=/usr/local/bin/password-safe serve --vault %h/.password-safe/vault.dat --addr 127.0.0.1:8787

Restart=on-failure
RestartSec=3

# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# 用户级 unit（systemd --user）时可不设 ProtectHome；系统级建议：
# ProtectHome=read-only
# ReadWritePaths=/home/YOUR_USERNAME/.password-safe
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# 服务启动后保险箱仍为锁定状态（v2 KEK/DEK）。解锁示例：
# curl -s -X POST http://127.0.0.1:8787/api/v1/unlock \
#   -H 'Content-Type: application/json' \
#   -d '{"password":"你的主密码"}'
# 若为旧 v1 库，请先在本机执行: password-safe migrate

# 浏览器扩展使用说明见 extension/README.md（启动 serve 无需主密码，由扩展解锁）。
# 用户级安装: cp 本文件 ~/.config/systemd/user/ && systemctl --user enable --now password-safe && sudo loginctl enable-linger $USER

[Install]
WantedBy=default.target
